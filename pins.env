# Every source at the commit the builds are known to work with (the same pins as data-a-live's CI,
# .github/workflows/turnip.yml). Any of them can be replaced by a local git checkout: SRC_<NAME>=/path.
UNIXNU_URL=https://github.com/UniXNU/UniXNU.git
UNIXNU_SHA=1a01c2afa197d975d04da892325c56b6b14aaecb
ADRENOPM4_URL=https://github.com/UniXNU/AdrenoPM4.git
ADRENOPM4_SHA=445f8fe6d115738352b9d78dc70af6d61aa7f62f
NATIVEADRENO_URL=https://github.com/UniXNU/NativeAdreno.git
NATIVEADRENO_SHA=b686b9054f57d393c80195b82568a09f8ca106a2
NATIVEMETAL_URL=https://github.com/UniXNU/NativeMetal.git
NATIVEMETAL_SHA=c6d29caad6d880cc8204ebe3bc34d77479a3255d
NATIVEMOBILEDISPLAY_URL=https://github.com/UniXNU/NativeMobileDisplay.git
NATIVEMOBILEDISPLAY_SHA=8666a9950c9699b368931d18cac92c0fdb2ce9c0
METAL2VULKAN_URL=https://github.com/steelbrain/metal2vulkan.git
METAL2VULKAN_SHA=720ef1ce9ae2a2068999a8675717418b9416283e
# Mesa: Chromium's mirror first (faster), freedesktop's GitLab if that fails.
MESA_URL="https://chromium.googlesource.com/external/gitlab.freedesktop.org/mesa/mesa https://gitlab.freedesktop.org/mesa/mesa.git"
MESA_SHA=85fda3b36405bcaea8bffc64aa4f2651dc90770d
# data-a-live: its iOS 16 adaptation of NativeMetal (tools/metal/adapt_ios16.py), the 128-IB ABI edit
# (tools/turnip/abi_128.py), vktest and mtltest sources.
DATA_A_LIVE_URL=https://github.com/ShueiTsuki/data-a-live.git
DATA_A_LIVE_SHA=a19a655e34c3c60c566524343c524845fd9a5a1e
# The CI release whose mtltest the AIR is taken from (its BUILD.txt names the commit).
MTLTEST_RELEASE=${MTLTEST_RELEASE:-https://github.com/ShueiTsuki/data-a-live/releases/download/turnip-ci}

# Tools
RUST_VERSION=1.98.0
APPLE_CODESIGN_VERSION=0.29.0
LLVM_MAJOR=18

# SDK collections offered when no SDK is given (third-party; never mirrored by this project).
SDK_SOURCES="theos https://github.com/theos/sdks.git iPhoneOS16.5.sdk
xybp888 https://github.com/xybp888/iOS-SDKs.git iPhoneOS16.5.sdk"
